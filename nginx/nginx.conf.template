# nginx.conf.template
# Next.js(3000), NestJS(3001) 프록시 설정
# API는 /api/* → NestJS
# 그 외 → Next.js
# fallback 처리 포함

user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    log_format  main  '$remote_addr - $remote_user [$time_local]  '
                      '"$request" $status $body_bytes_sent  '
                      '"$http_referer" "$http_user_agent"';
    access_log  /var/log/nginx/access.log  main;
    error_log   /var/log/nginx/error.log   warn;

    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    server {
        listen       ${PORT} default_server;
        server_name  _;

        # 정적 자산: Next.js
        location ~ ^/_next/ {
            proxy_pass         http://localhost:3000;
            proxy_set_header   Host $host;
        }
        location ~ ^/static/ {
            proxy_pass         http://localhost:3000;
            proxy_set_header   Host $host;
        }
        location = /favicon.ico {
            proxy_pass         http://localhost:3000;
            proxy_set_header   Host $host;
        }

        # 1) API 요청: /api/* → NestJS
        location /api/ {
            proxy_pass         http://localhost:3001;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection 'upgrade';
            proxy_set_header   Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_intercept_errors on;
            error_page 502 503 504 = @fallback_api;
        }

        # API fallback
        location @fallback_api {
            return 503 '{"error":"API temporarily unavailable"}';
            add_header Content-Type application/json;
        }

        # 2) 그 외 모든 요청 → Next.js
        location / {
            proxy_pass         http://localhost:3000;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection 'upgrade';
            proxy_set_header   Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_intercept_errors on;
            error_page 502 503 504 = @fallback_front;
        }

        # Next.js fallback
        location @fallback_front {
            return 503 '<html><body><h1>서비스 점검 중입니다.</h1></body></html>';
            add_header Content-Type text/html;
        }
    }
}
